{
  "name": "floor-editor-awesome-js",
  "private": false,
  "version": "1.0.0",
  "type": "module",
  "main": "floor-editor.umd.cjs",
  "module": "floor-editor.js",
  "exports": {
    ".": {
      "import": "./floor-editor.js",
      "require": "./floor-editor.umd.cjs"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:js": "vite build --config vite.libJS.config.ts",
    "publish": "node scripts/publish-lib.js",
    "publish:js": "node scripts/publish-libjs.js",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json",
    "build:css": "tailwindcss -i ./src/app.css -o ./src/tailwind-output.css"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@tailwindcss/cli": "^4.2.4",
    "@tailwindcss/vite": "^4.1.18",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^24.12.2",
    "tailwindcss": "^4.2.4",
    "typescript": "~6.0.2",
    "vite": "^8.0.9"
  },
  "dependencies": {
    "dxf-writer": "^1.18.4",
    "jspdf": "^4.1.0",
    "jszip": "^3.10.1",
    "svelte": "^5.55.4"
  }
}